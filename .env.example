# Copy to .env. These defaults are for local development — see README → Deploy for production,
# where NODE_ENV=production, PUBLIC_URL, DATABASE_URL and APP_SECRET are required.
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://awaaz:awaaz@localhost:5432/awaaz
# Production: 32+ random characters from `openssl rand -hex 32`. Changing it signs every phone out.
APP_SECRET=dev-only-secret-change-me

# --- Server ------------------------------------------------------------------
PORT=3000
# Number of proxies in front of the app: 0 locally, 1 behind Render, Railway, Fly or nginx.
TRUST_PROXY=0
APP_NAME=Awaaz
CONTACT_EMAIL=

# --- Audio storage -------------------------------------------------------------
# local (files under LOCAL_STORAGE_DIR) or r2 (Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/audio
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: a custom domain attached to the bucket. Leave empty to use short-lived presigned links.
R2_PUBLIC_BASE_URL=

# auto = convert uploads to AAC .m4a when ffmpeg is installed; on = require ffmpeg; off = store as recorded
TRANSCODE=auto
MAX_UPLOAD_MB=8
MAX_CLIPS_PER_ELDER=300
CREATE_PAGES_PER_HOUR=60

# --- Dedications (Razorpay) ----------------------------------------------------
# Leave the keys empty and town pages say "Dedications open soon".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEDICATION_DAYS=7
DEDICATION_TOWN_PAISE=110100
DEDICATION_FEATURED_PAISE=510000

# --- Heritage sponsor (one footer line) -------------------------------------
SPONSOR_TEXT=
SPONSOR_URL=

# --- Admin dashboard at /admin (disabled when empty) --------------------------
ADMIN_TOKEN=
