{
  "name": "awaaz",
  "version": "0.1.0",
  "private": true,
  "description": "A free family voice archive for Sindhi elders.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "images": "node scripts/render-images.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "express": "^5.2.1",
    "pg": "^8.16.0"
  }
}
